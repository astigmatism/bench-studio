# Address of this Bench Studio host; set its LAN IP for access from other machines.
BIND_IP=127.0.0.1
# The two production models share this router endpoint. 11436 is runtime status.
LLM_ENDPOINT=http://192.168.1.4:11434/v1
RUNTIME_URL=http://192.168.1.4:11436/api/status
PROJECT_DIR=/absolute/path/to/bench-studio
# Match the user/group that owns PROJECT_DIR/data on this Docker host.
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999
# Optional: pin model checks to a current model ID; empty uses a healthy discovered model.
SESSION_SMOKE_TARGET=
